<?xml version="1.0" encoding="utf-8"?>
<!-- Exact whitelist. The agent checkpoints SQLite before streaming the database. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="rezim_local_v1.db" />
        <include domain="sharedpref" path="hmyzak_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="rezim_local_v1.db" />
        <include domain="sharedpref" path="hmyzak_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
